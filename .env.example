GUNPLA_TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmnoPQRstuVWXyz
GUNPLA_TELEGRAM_CHAT_ID=123456789

# Optional. Comma-separated shop slugs, e.g. geeksheaven,gundamstore.
# Leave commented to run every registered shop.
#GUNPLA_SHOPS=

# Optional. Pin to a specific release, e.g. 0.1.0 or 0.1 (see GitHub Releases).
# Leave commented to always run the latest published release.
#GUNPLA_IMAGE_TAG=latest

# Optional. Host port the search UI (gunpla-ui service) is published on.
#GUNPLA_UI_PORT=8080

# Optional. Last-resort DKK->EUR rate. `collect` converts Gundam Store prices
# to EUR with today's ECB rate; if that lookup fails it reuses the rate of the
# previous run, and only falls back to this value on the very first run.
#GUNPLA_DKK_EUR_RATE=0.134

# Optional. If set, changes made in the UI (watches, near-miss decisions)
# need this token; the UI asks for it once. Set it before exposing the UI
# beyond a network you trust.
#GUNPLA_UI_TOKEN=
